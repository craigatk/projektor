# The projektor-publish dependency is a `file:..` link to the package under test.
# npm symlinks file: dependencies by default, which makes the CLI resolve its own
# dependencies (axios, minimist, ...) from publishers/node-script/node_modules --
# a directory that only exists if you happen to have installed there. install-links
# copies the package in instead, so its dependencies land in this project's
# node_modules and the tests run against a self-contained install.
install-links=true
